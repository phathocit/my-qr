# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO VERCEL & LOCAL DEV
# ========================================================

# 1. BIẾN PUBLIC (Trình duyệt có thể đọc, tiền tố NEXT_PUBLIC_)
# URL dự án Supabase Cloud của bạn (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Anon Public Key của Supabase (Project Settings > API > Project API Keys > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1Ni...

# Tên Storage Bucket private lưu trữ ảnh bằng chứng
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=evidence-photos

# URL chính thức của ứng dụng (Trên Vercel: https://your-project.vercel.app; Local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app

# 2. BIẾN SECRET (CHỈ SERVER ĐỌC, TUYỆT ĐỐI KHÔNG DÙNG TIỀN TỐ NEXT_PUBLIC_)
# Service Role Key của Supabase (Project Settings > API > Project API Keys > service_role)
# Dùng để chạy các thao tác quản trị / cleanup server-side
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1Ni...

# Thông tin tài khoản Quản trị viên (Khớp với UID và Email trong Supabase Auth)
ADMIN_EMAIL=admin@example.com
ADMIN_USER_ID=00000000-0000-0000-0000-000000000000

# 3. CẤU HÌNH ĐỒNG BỘ GOOGLE SHEETS (SERVER-SIDE)
# Email của Google Service Account (chia sẻ quyền Editor spreadsheet cho email này)
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-sync@your-gcp-project.iam.gserviceaccount.com

# Private key RSA của Service Account (lưu ý giữ nguyên \n nếu viết 1 dòng)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ID của bảng tính Google Sheet (docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID=1AbCdEfGhIjKlMnOpQrStUvWxYz1234567890

# Môi trường chạy
NODE_ENV=production

